[core]
  excludesfile = ~/.gitignore
  editor       = "/usr/local/bin/subl -w"

[push]
  default = current
  autoSetupRemote = true

[init]
  defaultBranch = main

[alias]
  co    = checkout
  drop  = checkout -- 
  head  = checkout HEAD -- 
  cp    = cherry-pick
  cl    = clone --recursive
  st    = status
  wt    = worktree
  wta   = worktree add
  wtl   = worktree list
  wtr   = worktree remove
  subup = submodule update --recursive --init
  puff  = !git pull --ff --ff-only && git pull -p
  pushf = push --force-with-lease
  hub   = !hub
  lg    = log --oneline --decorate --graph
  cm    = commit -m
  ca    = commit --amend
  aa    = add .
  branches = branch -l
  allbranches = branch -la

[color]
  branch = auto
  diff   = auto
  status = auto
  ui     = true

[diff]
  tool = opendiff

[difftool]
  prompt = false

[help]
  autocorrect = prompt

[include]
  path = .dotfiles/secret/.gitconfig

